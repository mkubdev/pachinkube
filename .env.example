# Upstash Redis (Vercel Marketplace -> Upstash). Leaderboard falls back to
# in-memory storage when these are missing, so local dev works without them.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (the Vercel Marketplace integration injects these names instead; both work)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Discord OAuth (https://discord.com/developers/applications -> OAuth2).
# Redirect URI to register: <origin>/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# openssl rand -base64 32
AUTH_SECRET=
# Set to your deployed origin in production, e.g. https://pachinkube.vercel.app
AUTH_URL=http://localhost:5173
