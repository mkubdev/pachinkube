{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": { "@sim/*": ["./src/sim/*"], "@render/*": ["./src/render/*"] },
    "baseUrl": "."
  },
  "include": ["src", "api", "tests", "tools/*.ts", "vite.config.ts"]
}
